{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worldfoam_fused_slab_build_attestation_v1.schema.json",
  "title": "WorldFoam fused-slab native build attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "generated_at",
    "scope",
    "variant",
    "package",
    "variant_dir",
    "receipt_schema",
    "receipt_schema_sha256",
    "source",
    "runtime",
    "toolchain",
    "extension",
    "compiled_operator_inventory",
    "receipt_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "worldfoam_fused_slab_native_build_attestation"},
    "status": {"const": "accepted"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "build_and_dispatcher_registration_only_no_metal_dispatch"},
    "variant": {"const": "world_foam_lane2_fused_slab_v0"},
    "package": {"const": "torch_world_foam_lane2_fused_slab"},
    "variant_dir": {"type": "string", "minLength": 1},
    "receipt_schema": {"type": "string", "minLength": 1},
    "receipt_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": [
        "contract_schema_version",
        "contract_path",
        "contract_sha256",
        "source_aggregate_sha256",
        "files",
        "schema_count",
        "schema_names",
        "schema_name_inventory_sha256",
        "full_schema_inventory_sha256",
        "required_post_103_schema_count"
      ],
      "properties": {
        "schema_count": {"const": 133},
        "required_post_103_schema_count": {"const": 30},
        "schema_names": {"type": "array", "minItems": 133, "maxItems": 133, "uniqueItems": true},
        "files": {"type": "array", "minItems": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "python_implementation",
        "python_version",
        "python_version_info",
        "python_executable",
        "python_soabi",
        "python_ext_suffix",
        "platform_system",
        "platform_machine",
        "torch_version"
      ],
      "properties": {
        "python_implementation": {"const": "cpython"},
        "python_version_info": {"prefixItems": [{"const": 3}, {"const": 11}]},
        "python_soabi": {"type": "string", "pattern": "^cpython-311-"},
        "python_ext_suffix": {"type": "string", "pattern": "^\\.cpython-311-darwin\\.so$"},
        "platform_system": {"const": "Darwin"},
        "platform_machine": {"type": "string", "minLength": 1}
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["cc", "cxx", "sysconfig_cc", "sysconfig_cxx", "sysconfig_ldshared", "environment"]
    },
    "extension": {
      "type": "object",
      "required": [
        "path",
        "repo_relative_path",
        "basename",
        "bytes",
        "sha256",
        "mtime_ns",
        "newest_native_input_mtime_ns"
      ],
      "properties": {
        "repo_relative_path": {
          "const": "third_party/fast-mac-gsplat/variants/world_foam_lane2_fused_slab_v0/torch_world_foam_lane2_fused_slab/_C.cpython-311-darwin.so"
        },
        "basename": {"const": "_C.cpython-311-darwin.so"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "compiled_operator_inventory": {
      "type": "object",
      "required": [
        "dispatch_key",
        "schema_count",
        "schema_names",
        "schemas",
        "schema_name_inventory_sha256",
        "full_schema_inventory_sha256",
        "missing_dispatch_kernels"
      ],
      "properties": {
        "dispatch_key": {"const": "CompositeExplicitAutograd"},
        "schema_count": {"const": 133},
        "schema_names": {"type": "array", "minItems": 133, "maxItems": 133, "uniqueItems": true},
        "schemas": {"type": "array", "minItems": 133, "maxItems": 133, "uniqueItems": true},
        "missing_dispatch_kernels": {"const": []}
      }
    },
    "receipt_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
