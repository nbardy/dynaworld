+def gaussian_time_basis_value(time_value, basis_count, sigma_scale, device, dtype):
+    if basis_count <= 0:
+        raise ValueError("dynamic_time_basis_count must be positive")
+    centers = torch.linspace(0.0, 1.0, basis_count, device=device, dtype=dtype)
+    if basis_count == 1:
+        return torch.ones(1, device=device, dtype=dtype)
+    spacing = 1.0 / float(basis_count - 1)
+    sigma = max(spacing * float(sigma_scale), 1e-4)
+    time = torch.as_tensor(float(time_value), device=device, dtype=dtype)
+    basis = torch.exp(-0.5 * ((time - centers) / sigma) ** 2.0)
+    return basis / basis.sum().clamp_min(1e-8)
+
