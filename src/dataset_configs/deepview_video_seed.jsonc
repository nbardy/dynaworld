{
  // Raw GT multi-camera light-field videos from:
  // https://github.com/augmentedperception/deepview_video_dataset
  //
  // Each scene archive contains up to 46 synchronized fisheye camera videos and
  // a models.json calibration file. The full configured set is about 65.5 GB
  // compressed, so the default download starts with the tiny structure-smoke
  // scene plus the smallest non-trivial scene.
  "dataset_name": "deepview_video_seed",
  "root_dir": "data/external/deepview_video",
  "project_url": "https://github.com/augmentedperception/deepview_video_dataset",
  "paper_url": "https://augmentedperception.github.io/deepviewvideo/",
  "download": {
    "scene_names": [
      "03_Dog",
      "15_Branches"
    ],
    "overwrite": false
  },
  "extract": {
    "overwrite": false
  },
  "scenes": [
    {
      "name": "01_Welder",
      "url": "https://storage.googleapis.com/deepview_video_raw_data/01_Welder.zip",
      "expected_size_bytes": 10554565078
    },
    {
      "name": "02_Flames",
      "url": "https://storage.googleapis.com/deepview_video_raw_data/02_Flames.zip",
      "expected_size_bytes": 5474948990
    },
    {
      "name": "03_Dog",
      "url": "https://storage.googleapis.com/deepview_video_raw_data/03_Dog.zip",
      "expected_size_bytes": 1398414399
    },
    {
      "name": "04_Truck",
      "url": "https://storage.googleapis.com/deepview_video_raw_data/04_Truck.zip",
      "expected_size_bytes": 1811297781
    },
