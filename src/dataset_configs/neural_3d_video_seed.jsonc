{
  // Curated external dataset ingest. This is deliberately separate from the
  // YouTube camera-motion miner.
  "dataset_name": "neural_3d_video_seed",
  "root_dir": "data/external/neural_3d_video",
  "github": {
    "owner": "facebookresearch",
    "repo": "Neural_3D_Video",
    "tag": "v1.0"
  },
  "download": {
    // Start with one smaller scene before pulling the whole release.
    // Set to [] or pass --all-assets to download every release asset.
    "asset_names": [
      "coffee_martini.zip"
    ],
    "overwrite": false
  },
  "validation_todo_assets": [
    {
      "scene": "cook_spinach",
      "asset_names": ["cook_spinach.zip"],
      "size_bytes": 1212423873
    },
    {
      "scene": "cut_roasted_beef",
      "asset_names": ["cut_roasted_beef.zip"],
      "size_bytes": 1143395383
    },
    {
      "scene": "flame_salmon_1",
      "asset_names": [
        "flame_salmon_1_split.z01",
        "flame_salmon_1_split.z02",
        "flame_salmon_1_split.z03",
        "flame_salmon_1_split.zip"
      ],
      "size_bytes": 4991502788,
      "repair_note": "Download all split parts, then run `zip -F flame_salmon_1_split.zip --out flame_salmon_1.zip` before extraction."
    },
    {
      "scene": "flame_steak",
      "asset_names": ["flame_steak.zip"],
      "size_bytes": 1199567884
    },
    {
      "scene": "sear_steak",
