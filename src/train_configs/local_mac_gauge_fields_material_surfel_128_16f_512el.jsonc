{
  // Material-coordinate gauge-field 128px local ablation.
  // Matches the recent 16f/128px comparison configs in data, resolution, and
  // 250-step ablation budget, but uses the toy material-surfel renderer.
  "arch": "gauge_fields_material_surfel",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "frame_source": "explicit_video",
    "max_frames": 0,
    "frame_indices": null
  },
  "model": {
    "num_elements": 512,
    "num_basis": 8,
    "init_basis_std": 0.001,
    "init_coeff_std": 0.0,
    "init_depth": 3.0,
    "init_radius": 0.05,
    "init_alpha_logit": -1.2
  },
  "camera": {
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0
  },
  "render": {
    "render_size": 128,
    "background": [1.0, 1.0, 1.0],
    "near_plane": 0.001,
    "far_plane": 10000.0,
    "min_radius_px": 0.75,
    "max_radius_px": 24.0,
    "max_alpha_per_element": 0.95,
    "pixel_chunk": 2048
  },
  "train": {
    "steps": 250,
    "lr": 0.002,
    "device": "auto",
    "seed": 0,
    "frames_per_step": 1,
    "train_frame_count": 16
  },
  "losses": {
    "rgb_weight": 1.0,
    "query_weight": 0.25,
    "flow_weight": 0.0,
    "depth_weight": 0.0,
    "arap_weight": 0.05,
    "smooth_weight": 0.02,
    "mass_weight": 0.001,
    "radius_weight": 0.001
  },
  "logging": {
    "log_every": 25,
    "log_to_wandb": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "gauge-fields-material-surfel-128-16f-512el",
    "wandb_tags": [
      "gauge-fields",
      "material-surfel",
      "128px",
      "16f",
      "250step"
    ],
    "wandb_mode": "online",
    "output_dir": "outputs/gauge_fields/material_surfel_128_16f_512el"
  }
}
