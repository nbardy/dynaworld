{
  // Ambitious learned-camera run: same high-motion full clip as the strong
  // residual-camera baseline, but camera.path_parameterization uses integrated
  // drone dynamics. Phase 0 is available through camera.init_teacher_path /
  // init_teacher_steps when a camera-following JSON is present; this config
  // leaves it off so the camera still overfits from renderer loss. Phase 1
  // keeps foam geometry/static appearance warm, then phase 2 releases the full
  // dynamic feature foam.
  "arch": "dynamic_powerfoam_metal",
  "data": {
    "video_path": "data/youtube_curated_spans/high_motion_smokes/hlaZbH_OFBU_seg_003_center_crop_8fps_full.mp4",
    "frame_source": "explicit_video",
    "max_frames": 56
  },
  "model": {
    "cells": 1024,
    "neighbor_count": 32,
    "adjacency_mode": "knn",
    "dynamic_mode": "token_rbf_features",
    "time_basis_count": 12,
    "time_basis_sigma_scale": 0.75,
    "temporal_init_mode": "fit",
    "dynamic_centers": true,
    "dynamic_radii": true,
    "dynamic_densities": true,
    "dynamic_features": true,
    "dynamic_normals": true,
    "dynamic_texel_sites": true,
    "feature_dim": 32,
    "feature_init_noise": 0.01,
    "feature_rgb_init": "logit",
    "token_dim": 128,
    "token_hidden_dim": 128,
    "token_hidden_layers": 1,
    "token_init_std": 0.02,
    "token_output_init_std": 0.0001,
    "token_point_residual_scale": 0.08,
    "token_z_residual_scale": 0.08,
    "token_radius_residual_scale": 0.05,
    "token_density_residual_scale": 0.08,
    "token_feature_residual_scale": 0.25,
    "token_normal_residual_scale": 0.08,
    "token_texel_site_residual_scale": 0.08,
    "token_temporal_residual_scale": 0.2,
    "init_from_video": true,
    "video_init_mode": "fixed_camera",
    "color_init_mode": "image",
    "image_init_depth": 2.0,
    "image_init_jitter": 0.2,
    "static_dynamic_split": true,
    "dynamic_cells": 128,
    "dynamic_cell_fraction": 0.125,
    "xy_extent": 1.25,
    "z_min": 1.0,
    "z_max": 3.25,
    "radius_init": 0.18,
    "radius_min": 0.03,
    "radius_scale": 0.72,
    "density_init": 64.0,
    "normal_init_jitter": 0.05,
    "num_texel_sites": 8,
    "texel_site_scale": 0.5
  },
  "camera": {
    "enabled": true,
    "mode": "learned_implicit",
    "lens_model": "pinhole",
    "base_fov_degrees": 55.0,
    "base_radius": 3.0,
    "token_dim": 64,
    "hidden_dim": 128,
    "time_basis_count": 12,
    "time_basis_sigma_scale": 0.75,
    "token_init_std": 0.02,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.05,
    "base_position": [0.0, 0.0, 0.0],
    "look_at": [0.0, 0.0, 1.0],
    "up": [0.0, 1.0, 0.0],
    "base_path_mode": "static",
    "path_parameterization": "integrated_drone",
    "drone_integration_horizon": 2.0,
    "drone_damping": 0.98,
    "drone_max_linear_velocity_ratio": 0.6,
    "drone_max_linear_acceleration_ratio": 1.2,
    "drone_max_angular_velocity_degrees": 180.0,
    "drone_max_angular_acceleration_degrees": 360.0,
    "drone_gimbal_max_rotation_degrees": 20.0,
    "drone_body_frame_translation": true,
    "init_teacher_path": null,
    "init_teacher_steps": 0,
    "init_teacher_lr": 0.01,
    "init_teacher_rotation_weight": 1.0,
    "init_teacher_translation_weight": 1.0,
    "init_teacher_velocity_weight": 0.25,
    "init_teacher_normalize_to_first": true,
    "distortion": null
  },
  "render": {
    "render_size": 512,
    "fov_degrees": 55.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0,
    "transmittance_threshold": 0.0001,
    "max_alpha": 0.99,
    "eps": 0.000001,
    "texel_temperature": 10.0,
    "normalize_features_by_alpha": true,
    "train_background_mode": "random_rgb",
    "eval_background_mode": "fixed_rgb",
    "background": [0.0, 0.0, 0.0],
    "random_background_min": 0.0,
    "random_background_max": 1.0
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": false,
    "weight_init": "kaiming",
    "weight_init_gain": 1.0,
    "view_condition": "none",
    "detach_view_condition": true,
    "init_rgb_identity": true
  },
  "train": {
    "steps": 180,
    "frames_per_step": 1,
    "lr": 0.01,
    "token_lr_multiplier": 1.0,
    "decoder_lr_multiplier": 1.0,
    "colorize_lr_multiplier": 0.5,
    "point_lr_multiplier": 0.1,
    "radius_lr_multiplier": 0.05,
    "density_lr_multiplier": 0.05,
    "feature_lr_multiplier": 1.0,
    "normal_lr_multiplier": 0.5,
    "texel_site_lr_multiplier": 0.25,
    "temporal_lr_multiplier": 0.35,
    "camera_lr_multiplier": 0.2,
    "static_only_steps": 60,
    "no_repaint_steps": 90,
    "seed": 17,
    "device": "mps"
  },
  "losses": {
    "l1_weight": 1.0,
    "mse_weight": 0.1,
    "radius_l2_weight": 0.0001,
    "density_l2_weight": 0.0,
    "temporal_center_accel_weight": 0.0005,
    "temporal_radius_accel_weight": 0.00005,
    "temporal_density_accel_weight": 0.000005,
    "temporal_feature_accel_weight": 0.00002,
    "temporal_coeff_l2_weight": 0.000001,
    "camera_motion_weight": 0.005,
    "camera_temporal_weight": 0.01,
    "camera_global_weight": 0.002,
    "camera_velocity_weight": 0.0005,
    "camera_acceleration_weight": 0.0005,
    "camera_gimbal_weight": 0.0005
  },
  "logging": {
    "log_every": 30,
    "image_log_every": 60,
    "video_log_every": 60,
    "always_log_last_step": true,
    "output_dir": "outputs/dynamic_powerfoam_metal/local_mac_token_dynamic_powerfoam_features_F32_1024_128dyn_drone_camera_staticwarm_youtube_hlaZbH_center_crop_8fps_512_56f_180step",
    "wandb_enabled": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "local-mac-token-dynamic-powerfoam-features-F32-1024-128dyn-drone-camera-staticwarm-youtube-hlaZbH-center-crop-8fps-512-56f-180step",
    "wandb_tags": [
      "dynamic-powerfoam",
      "metal",
      "token-rbf",
      "feature-foam",
      "F32",
      "static-dynamic",
      "drone-camera",
      "integrated-velocity",
      "camera-implicit",
      "fixed-gauge-init",
      "youtube",
      "high-motion",
      "full-clip",
      "center-crop",
      "8fps",
      "512px",
      "56f",
      "1024cells",
      "128dyn",
      "8sites"
    ]
  }
}
