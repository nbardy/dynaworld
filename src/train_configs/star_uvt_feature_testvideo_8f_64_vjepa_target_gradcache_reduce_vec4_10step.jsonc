{
  "arch": "star_uvt_feature_overfit",
  "data": {
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "start_seconds": null,
    "fps": null,
    "duration_seconds": null,
    "image_crop_mode": "center_square",
    "target_size": 64,
    "max_frames": 8
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "outputs/feature_cache/star_uvt_feature_targets/vjepa2_1_vitb_256crop_8f",
    "sample_cache_key": "star-uvt-vjepa2-1-vitb-256crop-8f-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": false,
    "save_dtype": "float16",
    "torch_dtype": "float32",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 256,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "feature_target": {
    "enabled": true,
    "layer": "vjepa_tokens",
    "token_grid_shape": [4, 16, 16],
    "loss_type": "mse",
    "loss_weight": 1.0,
    "rgb_loss_weight": 0.0,
    "channel_adapter": "truncate_or_pad",
    "temporal_spatial_adapter": "trilinear",
    "normalization": "channel_standardize"
  },
  "train": {
    "steps": 10,
    "lr": 0.02,
    "device": "mps",
    "seed": 41,
    "frame_chunk_size": 2,
    "require_loss_decrease": true,
    "require_gradient_flow": true,
    "require_no_tile_overflow": true
  },
  "feature_uvt": {
    "tube_count": 512,
    "feature_dim": 32,
    "render_mode": "feature_direct_gradcache_reduce_vec4",
    "tile_t": 2,
    "tile_capacity": 128,
    "alpha_threshold": 0.00392156862745098,
    "max_alpha": 0.99
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": false,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0
  },
  "output": {
    "out_json": "outputs/benchmarks/2026-05-19_star_uvt_feature_vjepa_target_8f_64px_512t_f32_gradcache_reduce_vec4_10step.json",
    "contact_sheet": null,
