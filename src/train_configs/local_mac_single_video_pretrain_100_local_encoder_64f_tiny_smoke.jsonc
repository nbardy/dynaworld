{
  // Cheap local validation lane for the same 100-item/64-frame manifest. This
  // proves the lazy cycling sampler and video-window loader without pulling a
  // V-JEPA checkpoint.
  "arch": "tokengs_video_implicit_camera",
  "data": {
    "sequence_dir": null,
    "frames_dir": null,
    "video_path": null,
    "manifest_path": "data/single_video_pretrain/dynaworld_single_video_pretrain_100_64f_v0/train_manifest.jsonl",
    "split": "train",
    "eval_manifest_path": null,
    "eval_split": "eval",
    "eval_max_sequences": 0,
    "train_manifest_load_mode": "lazy",
    "train_manifest_sample_mode": "cycle",
    "frame_source": "explicit_video_window",
    "max_frames": 0
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "local",
    "size": 32,
    "train_frame_count": 64,
    "tokens": 4,
    "gaussians_per_token": 4,
    "model_dim": 32,
    "bottleneck_dim": 32,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.0,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 1
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "dense",
    "render_size": 16,
    "auto_dense_limit": 400000,
    "tile_size": 8,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098
  },
  "train": {
    "steps": 1,
    "lr": 0.003,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 64
  },
  "losses": {
    "type": "l1",
    "l1_weight": 1.0,
    "mse_weight": 0.0,
    "dssim_weight": 0.0,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005
  },
  "logging": {
    "log_every": 1,
    "image_log_every": 1000,
    "video_log_every": 1000,
    "always_log_last_step": false,
    "log_initial_media": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "single-video-pretrain-100-local-encoder-64f-tiny-smoke",
    "wandb_tags": [
      "single-video-pretrain",
      "100items",
      "cycle-sampler",
      "64f",
      "local-encoder",
      "tiny-smoke"
    ]
  }
}
