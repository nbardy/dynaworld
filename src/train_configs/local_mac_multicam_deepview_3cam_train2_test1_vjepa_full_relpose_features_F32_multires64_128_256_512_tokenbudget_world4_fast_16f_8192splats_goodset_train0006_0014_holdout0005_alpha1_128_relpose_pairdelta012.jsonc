{
  // All-up ablation fork of the strongest no-VGGT F32 multicam baseline:
  // DeepView 03_Dog, train camera_0006/camera_0014, heldout camera_0005,
  // V-JEPA precomputed features, feature splatting, alpha_threshold=1/128,
  // target-dependent relpose pair-delta init, multires training, and an opt-in token
  // layout with non-decoded world/register/detail tokens plus a
  // resolution-coupled decoded-token budget. Render/loss resolution is
  // sampled with fast weighted probabilities capped at 512px:
  // 64px 25%, 128px 45%, 256px 25%, 512px 5%.
  "arch": "multicam_relative_pose_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "frame_indices": null,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": ["camera_0006", "camera_0014"],
    "multicam_heldout_camera": "camera_0005",
    "multicam_anchor_camera": "camera_0006",
    "multicam_condition_camera": "camera_0006"
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "data/feature_cache/multicam_deepview_static_dynamic_vjepa2_1_vitb_384_256px",
    "sample_cache_key": "multicam-deepview-3cam-train2-test1-full-relpose-vjepa2-1-vitb-384-256-16f-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": true,
    "release_extractor_after_prebake": true,
    "save_dtype": "float16",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 384,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "video_feature_token_stride": 9,
    "video_feature_output_dtype": "bf16",
    "camera_refine_with_decode_time": false,
    "size": 256,
    "train_frame_count": 16,
    "tokens": 136,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "token_layout": {
      "world_tokens": 4,
      "register_tokens": 2,
      "static_core_tokens": 56,
      "dynamic_core_tokens": 16,
      "detail_register_tokens": [1, 1],
      "static_detail_tokens": [24, 16],
      "dynamic_detail_tokens": [8, 8],
      "active_detail_level": 2
    },
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 64,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "feature_dim": 32,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 4,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2,
    "rig_init": "deepview",
    "rig_radius": 3.0,
    "rig_learn_global_se3": false,
    "rig_learn_per_camera_se3": false,
    "rig_anchor_policy": "fixed_first",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 256,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0078125,
    "camera_projection": "legacy_pinhole",
    "fast_mac": {
      "tile_size": 16,
      "feature_variant": "v5_features",
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.0078125,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "feature_background": 0.0,
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 250,
    "lr": 0.0003,
    "camera_rig_lr": null,
    "train_views_per_step": 0,
    "camera_swap_mode": "learned_residual",
    "camera_swap_pairs_per_step": 0,
    "camera_swap_include_self": true,
    "camera_swap_include_cross": true,
    "camera_swap_self_pair_probability": null,
    "relpose_output_mode": "full",
    "heldout_eval_camera_mode": "predicted_relpose",
    "trainable_scope": "all",
    "relpose_feature_frame_mode": "first_frame",
    "relpose_layers": 1,
    "relpose_query_count": 1,
    "relpose_mlp_ratio": 2.0,
    "relpose_head_hidden_dim": 64,
    "relpose_query_init_std": 0.02,
    "relpose_output_init_std": 0.0,
    "relpose_pair_delta_init_std": 0.12,
    "relpose_max_rotation_degrees": 45.0,
    "relpose_max_translation_ratio": 1.0,
    "relpose_pose_loss_weight": 1.0,
    "relpose_identity_loss_weight": 0.1,
    "relpose_cycle_loss_weight": 0.1,
    "frame_sampling": {"mode": "contiguous"},
    "multires_render_sizes": [64, 128, 256, 512],
    "multires_render_probabilities": [0.25, 0.45, 0.25, 0.05],
    "multires_token_detail_levels": [0, 0, 1, 2],
    "checkpoint_load_path": null,
    "checkpoint_save_path": "outputs/multicam_relative_pose/full_relpose_features_F32_multires64_128_256_512_tokenbudget_world4_fast_alpha1_128_relpose_pairdelta012_goodset_train0006_0014_holdout0005/checkpoint_final.pt",
    "amp": false,
    "amp_dtype": "bf16",
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": true,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0,
    "view_condition": "none",
    "detach_view_condition": true
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0,
    "background": {
      "train_mode": "random_rgb",
      "eval_mode": "white",
      "fixed_rgb": [1.0, 1.0, 1.0],
      "sample_scope": "step"
    }
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 50,
    "video_log_every": 250,
    "always_log_last_step": true,
    "feature_pca_log": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "multicam-deepview-3cam-goodset-train0006-0014-holdout0005-vjepa-full-relpose-features-F32-fast-multires64-128-256-512-tokenbudget-world4-alpha1-128-relpose-pairdelta012",
    "wandb_tags": [
      "feature-splatting",
      "alpha-threshold-ablation",
      "alpha1-128",
      "relpose-output-init-000",
      "relpose-pair-delta-init-012",
      "target-dependent-relpose-init",
      "feature-dim-32",
      "alpha-aware-composition",
      "colorize-1x1-sigmoid",
      "colorize-LN-kaiming-g4",
      "pca-viz",
      "multicam-feature-grid",
      "multicam",
      "deepview",
      "3cam-train2-test1",
      "heldout-camera",
      "static-dynamic-split",
      "token-layout",
      "world-tokens",
      "register-tokens",
      "dynamic-token-budget",
      "detail-level-schedule-0-0-1-2",
      "decoded-tokens-72-104-128",
      "precomputed-features",
      "vjepa2-1",
      "torchhub",
      "vitb-384",
      "256px",
      "multires-render",
      "multires-64-128-256-512",
      "weighted-resolutions",
      "fast-res-capped-512",
      "res-probs-25-45-25-5",
      "16f",
      "fast-mac",
      "8192splats",
      "camera-swap",
      "full-relpose",
      "no-vggt",
      "predicted-heldout-camera",
      "goodset-train0006-0014-holdout0005",
      "heldout-camera0005"
    ]
  }
}
