{
  "arch": "powerfoam_direct",
  "data": {
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 1,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_train_cameras": ["camera_0001", "camera_0015"],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0001"
  },
  "camera": {
    "lens_model": "pinhole",
    "rig_init": "deepview"
  },
  "model": {
    "cells": 16,
    "neighbor_count": 8,
    "init_from_video": true,
    "image_init_depth": 2.0,
    "image_init_jitter": 0.2,
    "num_texel_sites": 2,
    "sv_dof": 2,
    "sv_axis_init": 4.0,
    "radius_scale": 0.72,
    "adjacency_mode": "cech_aabb",
    "rebuild_adjacency_every": 1,
    "xy_extent": 1.25,
    "z_min": 1.0,
    "z_max": 3.25,
    "radius_init": 0.18,
    "radius_min": 0.03,
    "density_init": 16.0
  },
  "render": {
    "render_size": 32,
    "fov_degrees": 55.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0,
    "transmittance_threshold": 0.0001,
    "max_alpha": 0.99,
    "eps": 0.000001,
    "texel_temperature": 10.0,
    "background": [0.0, 0.0, 0.0]
  },
  "train": {
    "steps": 1,
    "frames_per_step": 2,
    "lr": 0.02,
    "seed": 17,
    "device": "cpu"
  },
  "losses": {
    "l1_weight": 1.0,
    "mse_weight": 0.1,
    "ssim_weight": 0.0,
    "normal_weight": 0.0,
    "contribution_weight": 0.0,
    "interpenetration_weight": 0.0,
    "radius_l2_weight": 0.0001,
    "density_l2_weight": 0.0
  },
  "logging": {
    "log_every": 1,
    "image_log_every": 1,
    "video_log_every": 1,
    "always_log_last_step": true,
    "output_dir": "outputs/powerfoam_direct/local_mac_powerfoam_direct_multicam_deepview_3cam_train2_test1_32_smoke",
    "wandb_enabled": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "local-mac-powerfoam-direct-multicam-deepview-3cam-train2-test1-32-smoke",
    "wandb_tags": [
      "powerfoam",
      "direct-reference",
      "multicam-val",
      "deepview",
      "train2-test1",
      "32px",
      "16cells",
      "smoke"
    ]
  }
}
