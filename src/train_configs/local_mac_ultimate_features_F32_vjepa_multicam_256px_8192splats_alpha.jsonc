{
  // Ultimate baseline config -- combines every winning ingredient from the
  // long session into one reference run:
  //   - V-JEPA 2.1 ViT-B/384 conditioning via the precomputed feature cache
  //   - Static/dynamic 96/32 token split, cross-attn-4 (canonical winner)
  //   - DeepView 3-cam train2/test1 multicam novel-view validation (Tier 2a)
  //   - 256x256 render + encoder size (up from 128px), 8192 splats
  //   - F=32 feature splatting + alpha-aware composition + random per-step bg
  //   - Session-winning colorize init: LN + Kaiming + gain=4, no hidden,
  //     view_condition=none (winner of probe_colorize_matrix; ran as
  //     2nz89pj3 / 3reqcya9 with final Loss 0.0653 at 400 steps).
  // 1000 steps because this is a real reference run, not a smoke test.
  "arch": "multicam_precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "frame_indices": null,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": ["camera_0001", "camera_0015"],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0001",
    "multicam_condition_camera": "camera_0001"
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    // New cache key (256px source frames produce a different prebake than the
    // 128px multicam V-JEPA cache; do not collide).
    "cache_dir": "data/feature_cache/multicam_deepview_static_dynamic_vjepa2_1_vitb_384_256px",
    "sample_cache_key": "multicam-deepview-3cam-train2-test1-static-dynamic-96-32-vjepa2-1-vitb-384-256-16f-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": true,
    "release_extractor_after_prebake": true,
    "save_dtype": "float16",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 384,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "size": 256,
    "train_frame_count": 16,
    "tokens": 128,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    // 128 tokens * 64 splats/token = 8192 splats total.
    "gaussians_per_token": 64,
    "model_dim": 128,
    "bottleneck_dim": 256,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    // 0.12 from the canonical V-JEPA multicam parent; not retuned for F=32.
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    // rgb_init applies only to the legacy F=3 path; silently ignored when
    // feature_dim != 3 because raw F-channel features aren't RGB-bounded.
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    // Feature splatting: 32-channel features per splat instead of RGB-3.
    // Triggers v5_features rasterizer (returns features+alpha), alpha-aware
    // composition + random per-step background in the recon path.
    "feature_dim": 32,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 4,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2,
    // Multicam rig: deepview seed, learned global + per-camera SE3, soft
    // anchor. Same as the canonical V-JEPA multicam parent.
    "rig_init": "deepview",
    "rig_radius": 3.0,
    "rig_learn_global_se3": true,
    "rig_learn_per_camera_se3": true,
    "rig_anchor_policy": "soft",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0001
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 256,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole",
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      // RGB-only background for the legacy F=3 v5 path (overridden at the
      // trainer layer by the random per-step bg under alpha-aware composition).
      "background": [1.0, 1.0, 1.0],
      // Feature-space background for F!=3 v5_features; scalar 0 broadcasts
      // across all 32 channels before the colorize MLP maps features to RGB.
      "feature_background": 0.0,
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 1000,
    "lr": 0.001,
    "camera_rig_lr": 0.001,
    "train_views_per_step": 0,
    "amp": false,
    "recon_backward_strategy": "batched",
    // 256px doubles per-frame memory vs 128px; keep microbatch at 4 to match
    // the V-JEPA multicam 128px parent. Drop to 2 if OOM on MPS.
    "temporal_microbatch_size": 4
  },
  // Top-level colorize section. Required when model.feature_dim != 3.
  // hidden_dim=null means a single 1x1 Conv2d(F, 3) + sigmoid (no MLP hidden).
  // LN + Kaiming-init scaled by gain=4, no hidden layer.
  // Saturation-safer winner from probe_colorize_matrix: lower deep-saturation
  // (Logit|>4|=0.019) at the cost of slightly less spatial diversity
  // (SpatStd=0.177). Ran as 2nz89pj3 / 3reqcya9 (final Loss 0.0653, 400 steps,
  // alpha-aware composition).
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": true,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0,
    "view_condition": "none",
    "detach_view_condition": true
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    // Camera-regularization weights match the parent multicam V-JEPA config
    // (the 128px ablate-time-clamp parent kept these at 0; the deepview-3cam
    // multicam parent also kept them at 0 because the rig regularizer takes
    // over). Keep at 0 so behavior matches the canonical V-JEPA multicam path.
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 250,
    "video_log_every": 500,
    "always_log_last_step": true,
    // Adds media/feature_pca_image to the W&B payload at image/video log
    // intervals. Renders the [T, F, H, W] feature buffer through PCA->RGB
    // for visualization. Detached, no autograd.
    "feature_pca_log": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "ultimate-features-F32-vjepa-multicam-256px-8192splats-alpha-1000step",
    "wandb_tags": [
      "feature-splatting",
      "feature-dim-32",
      "alpha-aware-composition",
      "random-background",
      "colorize-1x1-sigmoid",
      "colorize-LN-kaiming-g4",
      "pca-viz",
      "vjepa2-1-vitb-384",
      "precomputed-features",
      "static-dynamic-split",
      "static-96",
      "dynamic-32",
      "cross-attn-4",
      "multicam",
      "multicam-deepview-3cam",
      "deepview",
      "3cam-train2-test1",
      "heldout-camera",
      "tier-2a",
      "16f",
      "256px",
      "fast-mac",
      "8192splats",
      "1000step",
      "ultimate-baseline"
    ]
  }
}
