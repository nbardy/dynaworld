{
  // Feature-splatting variant of local_mac_unconditioned_tokens_fast.jsonc.
  //
  // Splats output a 32-channel feature vector instead of fixed RGB-3. After
  // rasterization, a 1x1-conv MLP (FeatureToColor) maps the rasterized
  // [B, T, 32, H, W] feature map to [B, T, 3, H, W] RGB for the loss. PCA of
  // the F-channel feature map is logged at image/video intervals alongside
  // the regular RGB preview, for sanity-checking what features the splats
  // are emitting.
  //
  // STATUS: This config will fail at the renderer guard until the
  // v5_features rasterizer fork lands. See:
  //   agent_notes/loose_notes/2026-04-29_17-30-00_codex_handoff_v5_features_rasterizer.md
  // The trainer-side wiring (model.feature_dim, colorize MLP, PCA viz) is
  // ready and tested for F=3 parity; F=32 is gated only by the rasterizer.
  "arch": "tokengs_video_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": "test_data/test_video_small_64_4fps.mp4",
    "frame_source": "explicit_video",
    "max_frames": 0
  },
  "model": {
    "variant": "unconditioned_tokens",
    "video_encoder_backend": "none",
    "size": 64,
    "train_frame_count": 8,
    "tokens": 64,
    "static_tokens": 48,
    "dynamic_tokens": 16,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 32,
    "model_dim": 128,
    "bottleneck_dim": 192,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    // rgb_init applies only to the legacy F=3 path; silently ignored when
    // feature_dim != 3 because raw F-channel features aren't RGB-bounded.
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    // Feature splatting: 32-channel features per splat instead of RGB-3.
    "feature_dim": 32,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 0,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 64,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      // RGB-only background for the legacy F=3 v5 path.
      "background": [1.0, 1.0, 1.0],
      // Feature-space background for F!=3 v5_features; scalar 0 broadcasts
      // across all 32 channels before the colorize MLP maps features to RGB.
      "feature_background": 0.0,
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 200,
    "lr": 0.001,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 8
  },
  // Top-level colorize section. Required when model.feature_dim != 3.
  // hidden_dim=null means a single 1x1 Conv2d(F, 3) + sigmoid (no MLP hidden).
  // hidden_dim=64 (or any int) inserts a Conv2d(F, hidden_dim) -> GELU ->
  // Conv2d(hidden_dim, 3) sandwich. activation="sigmoid" maps to [0, 1] for RGB.
  // view_condition options:
  //   "none"              -> colorize only rasterized features [F]
  //   "camera_center_ray" -> append one world camera-forward ray [3], broadcast per pixel
  //   "pixel_ray"         -> append each pixel's world ray direction [3]
  // LN + Kaiming-init scaled by gain=4, no hidden layer.
  // Saturation-safer alternative to LN+orth-g3: lower deep-saturation
  // (Logit|>4|=0.019 vs orth's 0.055) at the cost of slightly less spatial
  // diversity (SpatStd=0.177 vs 0.205). Same per-pixel cost. Pick this if
  // we'd rather lean on saturation-safety over engagement strength.
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": true,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0,
    "view_condition": "none",
    "detach_view_condition": true
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 200,
    "video_log_every": 200,
    "always_log_last_step": true,
    // Adds media/feature_pca_image (and video, when wired) to the W&B payload
    // at image/video log intervals. Renders the [T, F, H, W] feature buffer
    // through PCA->RGB for visualization. Detached, no autograd.
    "feature_pca_log": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "unconditioned-tokens-features-F32-LN-kaiming-g4",
    "wandb_tags": [
      "feature-splatting",
      "feature-dim-32",
      "unconditioned",
      "static-dynamic-split",
      "static-48",
      "dynamic-16",
      "no-video-conditioning",
      "camera-implicit",
      "8f",
      "64px",
      "fast-mac",
      "2048splats",
      "200step",
      "colorize-1x1-sigmoid",
      "pca-viz"
    ]
  }
}
