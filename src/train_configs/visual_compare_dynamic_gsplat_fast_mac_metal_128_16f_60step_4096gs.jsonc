{
  // Capacity-tier base dynamic-3DGS visual comparison. This doubles token count
  // from the medium tier for 4096 explicit Gaussians and runs a longer short
  // schedule through the fast-mac Metal rasterizer.
  "arch": "tokengs_video_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "frame_source": "explicit_video",
    "max_frames": 16
  },
  "model": {
    "variant": "unconditioned_tokens",
    "video_encoder_backend": "none",
    "size": 128,
    "train_frame_count": 16,
    "tokens": 128,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 32,
    "model_dim": 96,
    "bottleneck_dim": 192,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 0,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 128,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "fast_mac": {
      "rgb_variant": "v6_refined",
      "feature_variant": "v5_features",
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "auto",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144,
      "active_policy": "off",
      "stop_count_mode": "adaptive"
    }
  },
  "train": {
    "steps": 60,
    "lr": 0.001,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 15,
    "image_log_every": 60,
    "video_log_every": 60,
    "always_log_last_step": true,
    "log_initial_media": false,
    "wandb_enabled": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "visual-compare-dynamic-gsplat-fast-mac-metal-128-16f-60step-4096gs",
    "wandb_tags": [
      "visual-compare",
      "dynamic-gsplat",
      "fast-mac",
      "metal",
      "v6-refined",
      "128px",
      "16f",
      "4096gs",
      "capacity-tier"
    ],
    "wandb_mode": "offline",
    "output_dir": "outputs/visual_comparisons/dynamic_gsplat_fast_mac_metal_128_16f_60step_4096gs"
  }
}
