{
  // 256px local-encoder control for the scene-distinct 30-clip dataset.
  // This should be run next to the V-JEPA fpc16/256 config below. It uses the
  // same 20 train / 10 test source-video split, clip length, renderer, splat
  // budget, train schedule, and loss; only the video encoder differs.
  "arch": "tokengs_video_implicit_camera",
  "data": {
    "sequence_dir": null,
    "frames_dir": null,
    "video_path": null,
    "manifest_path": "data/youtube_scene_distinct/clip_sets/youtube_scene_distinct_30_256_4fps_16f/manifest.jsonl",
    "split": "train",
    "eval_manifest_path": "data/youtube_scene_distinct/clip_sets/youtube_scene_distinct_30_256_4fps_16f/manifest.jsonl",
    "eval_split": "test",
    "eval_max_sequences": 2,
    "frame_source": "summary_sampled",
    "max_frames": 0
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "local",
    "size": 256,
    "train_frame_count": 16,
    "tokens": 64,
    "gaussians_per_token": 32,
    "model_dim": 128,
    "bottleneck_dim": 256,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.3,
    "head_output_init_std": 0.06,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 1,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 256,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 100,
    "lr": 0.001,
    "amp": false,
    "recon_backward_strategy": "microbatch",
    "temporal_microbatch_size": 2
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 25,
    "video_log_every": 100,
    "always_log_last_step": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "local-mac-scene-distinct-30-local-encoder-256-fast-mac-2048splats",
    "wandb_tags": [
      "local-mac",
      "scene-distinct",
      "30clips",
      "20train",
      "10test",
      "compare-vjepa",
      "local-encoder",
      "non-pretrained",
      "16f",
      "256px",
      "fast-mac",
      "2048splats"
    ]
  }
}
