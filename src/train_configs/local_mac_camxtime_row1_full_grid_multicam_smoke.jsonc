{
  // One-step CamXTime row-one multicam smoke.
  //
  // Uses two fixed full-grid camera videos for training and a third camera as
  // heldout supervision. The model is intentionally unconditioned so the smoke
  // tests the loader, camera rig, renderer, and multicam train loop without
  // paying any feature-cache or V-JEPA cost.
  "arch": "multicam_precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 4,
    "frame_indices": null,
    "multicam_manifest": "src/dataset_configs/camxtime_row1_full_grid_smoke_manifest.jsonl",
    "multicam_split": "smoke",
    "multicam_sample_id": "camxtime_scene_1_train_camera_000_020_holdout_040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": null,
    "multicam_heldout_cameras": null,
    "multicam_heldout_camera": null,
    "multicam_anchor_camera": null,
    "multicam_condition_camera": null
  },
  "features": {
    "cache_dir": null
  },
  "model": {
    "variant": "unconditioned_tokens",
    "video_encoder_backend": "none",
    "size": 64,
    "train_frame_count": 4,
    "tokens": 8,
    "static_tokens": 6,
    "dynamic_tokens": 2,
    "dynamic_time_basis_count": 4,
    "dynamic_time_max_frequency": 4.0,
    "dynamic_motion_extent": 0.25,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 8,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "tubelet_size_t": 4,
    "patch_compression": 8,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 1,
    "time_fourier_bands": 4,
    "time_max_frequency": 32.0,
    "camera_refine_with_decode_time": false
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2,
    "rig_init": "camxtime",
    "rig_radius": 3.0,
    "rig_learn_global_se3": true,
    "rig_learn_per_camera_se3": true,
    "rig_anchor_policy": "soft",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0001
  },
  "render": {
    "renderer": "dense",
    "render_size": 64,
    "auto_dense_limit": 400000,
    "tile_size": 8,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole",
    "fast_mac": null
  },
  "train": {
    "steps": 1,
    "lr": 0.001,
    "camera_rig_lr": 0.001,
    "train_views_per_step": 0,
    "camera_swap_mode": "external_rig",
    "camera_swap_pairs_per_step": 0,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0,
    "background": {
      "train_mode": "white",
      "eval_mode": "white",
      "fixed_rgb": [1.0, 1.0, 1.0],
      "sample_scope": "step"
    }
  },
  "logging": {
    "log_every": 1,
    "image_log_every": 1,
    "video_log_every": 1,
    "always_log_last_step": true,
    "feature_pca_log": false,
    "wandb_mode": "offline",
    "wandb_project": "dynaworld",
    "wandb_run_name": "camxtime-row1-full-grid-multicam-smoke",
    "wandb_tags": [
      "camxtime",
      "row1",
      "full-grid",
      "multicam",
      "train2-holdout1",
      "smoke",
      "unconditioned-tokens",
      "no-feature-cache",
      "dense-renderer",
      "64px",
      "4f"
    ]
  }
}
