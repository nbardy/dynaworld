// Historical cap128 rows overflow; cap512 is unsupported by the installed backend.
{
  "seed": 17,
  "device": "mps",
  "backward_policy": "fast_exploration",
  "timeout_seconds": 600,
  "logging": {
    "wandb_enabled": true,
    "wandb_mode": "offline"
  },
  "output_dir": "outputs/benchmarks/2026-09-12_world_tubes_sampling_ablation",
