{
  "arch": "powerfoam_metal",
  "data": {
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_train_cameras": ["camera_0001", "camera_0015"],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0001"
  },
  "camera": {
    "lens_model": "pinhole",
    "rig_init": "deepview"
  },
  "model": {
    "cells": 1024,
    "neighbor_count": 16,
    "adjacency_mode": "cech_aabb",
    "init_from_video": true,
    "radius_min": 0.015,
    "density_init": 64.0,
    "feature_mode": "quaternion_height_sv_texel_surface"
  },
  "render": {
    "render_size": 128,
    "use_tiled": false,
    "use_raytrace": true
  },
  "train": {
    "steps": 80,
    "frames_per_step": 4,
    "lr": 0.02,
    "lr_schedule": "cosine",
    "points_lr_init": 0.0,
    "points_lr_final": 0.0,
    "density_lr_init": 0.0,
    "density_lr_final": 0.0,
    "radii_lr_init": 0.0,
    "radii_lr_final": 0.0,
    "quaternions_lr_init": 0.0,
    "quaternions_lr_final": 0.0,
    "texel_sites_lr_init": 0.0,
    "texel_sites_lr_final": 0.0,
    "texel_sv_axis_lr_init": 0.0,
    "texel_sv_axis_lr_final": 0.0,
    "texel_sv_rgb_lr_init": 0.01,
    "texel_sv_rgb_lr_final": 0.001,
    "texel_height_lr_init": 0.0,
    "texel_height_lr_final": 0.0,
    "seed": 17,
    "device": "mps"
  },
  "losses": {
    "l1_weight": 1.0,
    "mse_weight": 0.1,
    "radius_l2_weight": 0.0001,
    "normal_weight": 0.0,
    "contribution_weight": 0.0,
    "interpenetration_weight": 0.0
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 20,
    "video_log_every": 80,
    "always_log_last_step": true,
    "output_dir": "outputs/powerfoam_metal/local_mac_powerfoam_metal_multicam_deepview_3cam_train2_test1_quaternion_height_sv_raytrace_128_16f_1024cells_80step_coloronly_noaux",
    "wandb_enabled": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "local-mac-powerfoam-metal-multicam-deepview-3cam-train2-test1-quaternion-height-sv-raytrace-128-16f-1024cells-80step-coloronly-noaux",
    "wandb_tags": [
      "powerfoam",
      "metal",
      "multicam-val",
      "deepview",
      "train2-test1",
      "quaternion-height-sv-texel-surface",
      "raytrace",
      "128px",
      "16f",
      "1024cells",
      "coloronly",
      "noaux"
    ]
  }
}
