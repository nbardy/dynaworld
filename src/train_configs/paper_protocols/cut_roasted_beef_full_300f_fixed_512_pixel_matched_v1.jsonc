{
  "name": "cut_roasted_beef_full_300f_fixed_512_pixel_matched_v1",
  "enabled": true,
  "dataset": {
    "manifest": "src/dataset_configs/neural3d_cut_roasted_beef_train2_holdout1_full_300f_manifest.jsonl",
    "sample_id": "neural3d_cut_roasted_beef_train_cam14_cam18_holdout_cam16_full_300f",
    "train_cameras": ["cam14", "cam18"],
    "heldout_cameras": ["cam16"],
    "frame_count": 300,
    "fps": 30.0
  },
  // Keep this route stage-free until native4d has an independently sealed
  // stage-transition transaction. It is pixel-matched to the progressive
  // schedule and directly comparable with every other G4 representation.
  "steps": 300,
  "max_train_seconds": 86400.0,
  "frames_per_step": 4,
  "same_time_count": 2,
  "local_time_count": 1,
  "local_time_radius": 8,
  "sampler_seed_offset": 7001,
  "stages": [
    {
      "label": "fixed_512w",
      "until_step": 300,
      "image_size": [384, 512],
      "primitive_count": 1024,
      "frames_per_step": 4,
      "lr_multiplier": 0.35
    }
  ]
}
