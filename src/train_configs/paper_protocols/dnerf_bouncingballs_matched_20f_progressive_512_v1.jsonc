{
  "name": "dnerf_bouncingballs_matched_20f_progressive_512_v1",
  "enabled": true,
  "dataset": {
    "manifest": "src/dataset_configs/dnerf_bouncingballs_train_trajectory_holdout_test_20f_manifest.jsonl",
    "sample_id": "dnerf_bouncingballs_train_trajectory_holdout_test_20f",
    "train_cameras": ["train_trajectory"],
    "heldout_cameras": ["test_trajectory"],
    "frame_count": 20,
    "fps": 20.0
  },
  "steps": 600,
  "max_train_seconds": 86400.0,
  "frames_per_step": 4,
  // There is one observed trajectory, so same-time pairs cannot be drawn
  // from distinct source cameras. The official timestamps still pair each
  // train pose with a different heldout test pose for evaluation.
  "same_time_count": 1,
  "local_time_count": 2,
  "local_time_radius": 3,
  "sampler_seed_offset": 7001,
  "stages": [
    {
      "label": "bootstrap_128w",
      "until_step": 160,
      "image_size": [128, 128],
      "primitive_count": 256,
      "frames_per_step": 4,
      "lr_multiplier": 1.0
    },
    {
      "label": "geometry_256w",
      "until_step": 360,
      "image_size": [256, 256],
      "primitive_count": 512,
      "frames_per_step": 4,
      "lr_multiplier": 0.65
    },
    {
      "label": "detail_512w",
      "until_step": 600,
      "image_size": [512, 512],
      "primitive_count": 1024,
      "frames_per_step": 4,
      "lr_multiplier": 0.35
    }
  ]
}
