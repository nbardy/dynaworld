{
  // One frozen public-data matrix for the World Tubes submission. This is a
  // workload declaration, not permission to execute it on the incident host.
  "name": "world_tubes_full_public_matrix_v1",
  "runs": [
    {
      "role": "primary_progressive",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_full_300f_progressive_512_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration"
    },
    {
      "role": "pixel_matched_control",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_full_300f_fixed_512_pixel_matched_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration"
    },
    {
      "role": "sampler_control",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_full_300f_progressive_global_shuffle_512_v1.jsonc",
      "seeds": [17],
      "world_tubes_backward_policy": "fast_exploration"
    },
    {
      "role": "camera_split_breadth",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_triplet_cam13_cam18_holdout_cam00_progressive_512_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration",
      "worldfoam_initializer": "video"
    },
    {
      "role": "camera_split_breadth",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_triplet_cam02_cam07_holdout_cam12_progressive_512_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration",
      "worldfoam_initializer": "video"
    },
    {
      "role": "scene_breadth",
      "protocol": "src/train_configs/paper_protocols/cook_spinach_full_300f_progressive_512_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration",
      "worldfoam_initializer": "video"
    },
    {
      "role": "scene_breadth",
      "protocol": "src/train_configs/paper_protocols/cut_roasted_beef_full_300f_progressive_512_v1.jsonc",
      "seeds": [17, 29, 43],
      "world_tubes_backward_policy": "fast_exploration",
      "worldfoam_initializer": "video"
    },
    {
      "role": "controlled_dnerf_breadth",
      "protocol": "src/train_configs/paper_protocols/dnerf_bouncingballs_matched_20f_progressive_512_v1.jsonc",
      "seeds": [17],
      "world_tubes_backward_policy": "fast_exploration",
      "worldfoam_initializer": "video"
    },
    {
      // Correctness/timing audit only. Never aggregate this one-step 64-wide
      // row with the 512-wide quality protocols above.
      "role": "deterministic_correctness_timing",
      "protocol": "src/train_configs/paper_protocols/coffee_martini_full_300f_smoke_1step.jsonc",
      "seeds": [17],
      "world_tubes_backward_policy": "deterministic_quality"
    }
  ]
}
