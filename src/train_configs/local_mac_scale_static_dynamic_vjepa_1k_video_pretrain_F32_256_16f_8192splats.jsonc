{
  // Broad same-video pretrain setup for the current V-JEPA + static/dynamic
  // token formulation. This uses single-view clips from prepared YouTube
  // sources plus the prepared real/synthetic-ish video datasets as a scale
  // pretraining lane. It is not the heldout novel-view benchmark; use the
  // multicam/relative-pose configs for train-view-in, heldout-camera-out loss.
  // The data contract and current row inventory live in
  // research_notes/data_contract.md.
  //
  // Regenerate the no-copy 1k manifest with:
  //   PYTHONPATH=src/train uv run python src/dataset_scripts/build_single_video_pretrain_manifest.py
  //
  // If you want a materialized frame-clip alternative instead:
  //   ./src/train_scripts/build_dynaworld_scale_1k_clip_dataset.sh dry-run
  //   ./src/train_scripts/build_dynaworld_scale_1k_clip_dataset.sh build
  "arch": "precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": null,
    "frames_dir": null,
    "video_path": null,
    "manifest_path": "data/single_video_pretrain/dynaworld_single_video_pretrain_1k_v0/train_manifest.jsonl",
    "split": "train",
    "eval_manifest_path": null,
    "eval_split": "test",
    "eval_max_sequences": 0,
    "train_manifest_load_mode": "lazy",
    "frame_source": "summary_sampled",
    "max_frames": 0
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "data/feature_cache/scale_static_dynamic_vjepa2_1_vitb_384_F32_256px_1k",
    "sample_cache_key": "scale-static-dynamic-vjepa2-1-vitb-384-F32-256-16f-1k-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": false,
    "release_extractor_after_prebake": false,
    "save_dtype": "float16",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 384,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "video_feature_token_stride": 9,
    "video_feature_output_dtype": "bf16",
    "camera_refine_with_decode_time": false,
    "size": 256,
    "train_frame_count": 16,
    "tokens": 136,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "token_layout": {
      "world_tokens": 4,
      "register_tokens": 2,
      "static_core_tokens": 56,
      "dynamic_core_tokens": 16,
      "detail_register_tokens": [1, 1],
      "static_detail_tokens": [24, 16],
      "dynamic_detail_tokens": [8, 8],
      "active_detail_level": 2
    },
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 64,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "feature_dim": 32,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 4,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 256,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0078125,
    "camera_projection": "legacy_pinhole",
    "fast_mac": {
      "tile_size": 16,
      "feature_variant": "v5_features",
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.0078125,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "feature_background": 0.0,
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 2000,
    "lr": 0.0003,
    "frame_sampling": {"mode": "contiguous"},
    "amp": false,
    "amp_dtype": "bf16",
    "recon_backward_strategy": "microbatch",
    "temporal_microbatch_size": 4
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": true,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0,
    "view_condition": "none",
    "detach_view_condition": true
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0,
    "background": {
      "train_mode": "random_rgb",
      "eval_mode": "white",
      "fixed_rgb": [1.0, 1.0, 1.0],
      "sample_scope": "step"
    }
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 250,
    "video_log_every": 500,
    "always_log_last_step": true,
    "feature_pca_log": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "scale-static-dynamic-vjepa-1k-video-pretrain-F32-256px-8192splats",
    "wandb_tags": [
      "scale-pretrain",
      "single-video",
      "youtube-prepared",
      "synthetic-video-sources",
      "feature-splatting",
      "feature-dim-32",
      "alpha-aware-composition",
      "colorize-1x1-sigmoid",
      "colorize-LN-kaiming-g4",
      "pca-viz",
      "vjepa2-1-vitb-384",
      "precomputed-features",
      "lazy-manifest",
      "static-dynamic-split",
      "static-96",
      "dynamic-32",
      "token-layout",
      "world-tokens",
      "register-tokens",
      "16f",
      "256px",
      "fast-mac",
      "8192splats",
      "2000step",
      "lr3e-4"
    ]
  },
  "export": {
    "enabled": false,
    "output_root": "outputs/browser_exports",
    "sequence_index": 0,
    "window_start": 0
  }
}
