{
  // Mixed same-view plus heldout-view plumbing smoke. This uses RGB-pyramid
  // features so the run tests trainer behavior without paying V-JEPA bake cost.
  "arch": "mixed_same_heldout_precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "manifest_path": "data/clip_sets/local_mac_30_64_4fps_16f/manifest.jsonl",
    "split": "train",
    "train_manifest_load_mode": "lazy",
    "train_manifest_sample_mode": "cycle",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 2,
    "frame_indices": null,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": ["camera_0001", "camera_0015"],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0001",
    "multicam_condition_camera": "camera_0001"
  },
  "features": {
    "extractor": "rgb_pyramid",
    "cache_dir": "data/feature_cache/multicam_smoke_rgb_pyramid",
    "sample_cache_key": "multicam-deepview-3cam-train2-test1-rgb-pyramid-32-2f-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": true,
    "release_extractor_after_prebake": false,
    "save_dtype": "float16",
    "rgb_pyramid_scales": [1, 2]
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "size": 32,
    "train_frame_count": 2,
    "tokens": 8,
    "static_tokens": 6,
    "dynamic_tokens": 2,
    "dynamic_time_basis_count": 4,
    "dynamic_time_max_frequency": 4.0,
    "dynamic_motion_extent": 0.25,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 8,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "tubelet_size_t": 2,
    "patch_compression": 8,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 1,
    "time_fourier_bands": 4,
    "time_max_frequency": 32.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2,
    "rig_init": "deepview",
    "rig_radius": 3.0,
    "rig_learn_global_se3": true,
    "rig_learn_per_camera_se3": true,
    "rig_anchor_policy": "soft",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0001
  },
  "render": {
    "renderer": "dense",
    "render_size": 32,
    "auto_dense_limit": 400000,
    "tile_size": 8,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole",
    "fast_mac": null
  },
  "train": {
    "steps": 10,
    "lr": 0.001,
    "camera_rig_lr": 0.001,
    "train_views_per_step": 0,
    "mixed_schedule_mode": "alternate",
    "same_view_weight": 1.0,
    "novel_view_weight": 1.0,
    "heldout_views_per_step": 1,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 2
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 1,
    "image_log_every": 1000,
    "video_log_every": 1000,
    "always_log_last_step": true,
    "log_initial_media": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "mixed-same-heldout-rgb-pyramid-10step-smoke",
    "wandb_tags": [
      "multicam",
      "deepview",
      "3cam-train2-test1",
      "rgb-pyramid",
      "static-dynamic-split",
      "mixed-smoke"
    ]
  }
}
