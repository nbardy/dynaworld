{
  // True 512px render target for the overnight 300-clip local lane.
  // Speed variant: keep the same 512 center-crop/render and token layout, but halve
  // V-JEPA feature-loss frame samples with temporal_stride=8.
  // Data/V-JEPA conditioning/V-JEPA feature loss all use the same 512 center-square
  // source crop; V-JEPA itself is resized internally to 256 for local MPS memory.
  "arch": "precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": null,
    "frames_dir": null,
    "video_path": null,
    "manifest_path": "data/single_video_pretrain/dynaworld_single_video_pretrain_300_youtube_64f_512_v0/train_manifest.jsonl",
    "split": "train",
    "eval_manifest_path": null,
    "eval_split": "eval",
    "eval_max_sequences": 0,
    "train_manifest_load_mode": "lazy",
    "train_manifest_sample_mode": "cycle",
    "frame_source": "explicit_video_window",
    "image_crop_mode": "center_square",
    "max_frames": 0
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "data/feature_cache/single_video_pretrain_300_youtube_vjepa2_1_vitb_256crop_64f_512center_nativefps",
    "sample_cache_key": "single-video-pretrain-300-youtube-vjepa2-1-vitb-256crop-64f-512center-nativefps-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": false,
    "release_extractor_after_prebake": false,
    "save_dtype": "float16",
    "torch_dtype": "float32",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 256,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "video_feature_token_stride": 9,
    "video_feature_output_dtype": null,
    "camera_refine_with_decode_time": true,
    "size": 512,
    "train_frame_count": 64,
    "tokens": 40,
    "static_tokens": 24,
    "dynamic_tokens": 8,
    "token_layout": {
      "world_tokens": 4,
      "register_tokens": 2,
      "static_core_tokens": 16,
      "dynamic_core_tokens": 4,
      "detail_register_tokens": [1, 1],
      "static_detail_tokens": [4, 4],
      "dynamic_detail_tokens": [2, 2],
      "active_detail_level": 2
    },
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 16,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.3,
    "head_output_init_std": 0.06,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 1,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 512,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0078125,
    "fast_mac": {
      "tile_size": 16,
      "rgb_variant": "v6_refined",
      "feature_variant": "v5_features",
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.0078125,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144,
      "active_policy": "off",
      "stop_count_mode": "adaptive"
    }
  },
  "train": {
    "steps": 300,
    "lr": 0.0005,
    "amp": false,
    "recon_backward_strategy": "microbatch",
    "temporal_microbatch_size": 16,
    "profile_timing": true,
    "profile_timing_sync": true,
    "profile_timing_log_every": 5
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0,
    "vjepa_feature_weight": 0.05,
    "vjepa_feature_model_id": "vjepa2_1_vit_base_384",
    "vjepa_feature_dtype": "float32",
    "vjepa_feature_crop_size": 256,
    "vjepa_feature_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt",
    "vjepa_feature_temporal_stride": 8,
    "vjepa_feature_normalize": true,
    "vjepa_feature_loss_type": "mse"
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 50,
    "video_log_every": 100,
    "always_log_last_step": true,
    "log_initial_media": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "single-video-pretrain-300-youtube-64f-512render-static-dynamic-register-vjepa-loss-stride8-speed",
    "wandb_tags": [
      "single-video-pretrain",
      "300-youtube",
      "64f",
      "natural-fps",
      "center-square",
      "512target",
      "512render",
      "precomputed-features",
      "vjepa-feature-loss",
      "vjepa-loss-stride8",
      "static-dynamic-split",
      "register-tokens",
      "implicit-camera",
      "fast-mac",
      "v6-refined-rgb",
      "512splats"
    ]
  }
}
