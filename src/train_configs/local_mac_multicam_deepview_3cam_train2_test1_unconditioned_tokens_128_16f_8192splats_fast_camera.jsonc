{
  // No-V-JEPA multicam TokenGS baseline under the DeepView train-2/test-1 contract.
  // Uses the same external camera-rig/render/loss path as the precomputed V-JEPA
  // trainer, but disables the feature cache and uses learned unconditioned tokens.
  "arch": "multicam_precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "frame_indices": null,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": ["camera_0001", "camera_0015"],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0001",
    "multicam_condition_camera": "camera_0001"
  },
  "model": {
    "variant": "unconditioned_tokens",
    "video_encoder_backend": "none",
    "size": 128,
    "train_frame_count": 16,
    "tokens": 128,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 64,
    "model_dim": 128,
    "bottleneck_dim": 256,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 4,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0,
    "camera_refine_with_decode_time": false
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2,
    "rig_init": "deepview",
    "rig_radius": 3.0,
    "rig_learn_global_se3": true,
    "rig_learn_per_camera_se3": true,
    "rig_anchor_policy": "soft",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0001
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 128,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole",
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 250,
    "lr": 0.001,
    "camera_rig_lr": 0.001,
    "train_views_per_step": 0,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 50,
    "video_log_every": 250,
    "always_log_last_step": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "multicam-deepview-3cam-train2-test1-unconditioned-tokens-128-16f-8192splats-fast-camera",
    "wandb_tags": [
      "multicam",
      "deepview",
      "3cam-train2-test1",
      "heldout-camera",
      "static-dynamic-split",
      "unconditioned-tokens",
      "no-vjepa",
      "no-feature-cache",
      "128px",
      "16f",
      "fast-mac",
      "8192splats",
      "fast-camera"
    ]
  }
}
