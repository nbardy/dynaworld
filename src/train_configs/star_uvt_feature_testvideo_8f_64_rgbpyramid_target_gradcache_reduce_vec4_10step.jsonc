{
  "arch": "star_uvt_feature_overfit",
  "data": {
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "start_seconds": null,
    "fps": null,
    "duration_seconds": null,
    "image_crop_mode": "center_square",
    "target_size": 64,
    "max_frames": 8
  },
  "features": {
    "extractor": "rgb_pyramid",
    "cache_dir": "outputs/feature_cache/star_uvt_feature_targets/rgb_pyramid",
    "force_rebake": false,
    "keep_in_memory": true,
    "save_dtype": "float32",
    "sample_cache_key": "star-uvt-rgbpyramid-target-8f64px-v1",
    "cache_version": 1,
    "rgb_pyramid_scales": [1]
  },
  "feature_target": {
    "enabled": true,
    "layer": "rgb_x1",
    "loss_type": "mse",
    "loss_weight": 1.0,
    "rgb_loss_weight": 0.0,
    "channel_adapter": "repeat_truncate",
    "temporal_spatial_adapter": "trilinear",
    "normalization": "none"
  },
  "train": {
    "steps": 10,
    "lr": 0.02,
    "device": "mps",
    "seed": 41,
    "frame_chunk_size": 2,
    "require_loss_decrease": true,
    "require_gradient_flow": true,
    "require_no_tile_overflow": true
  },
  "feature_uvt": {
    "tube_count": 512,
    "feature_dim": 32,
    "render_mode": "feature_direct_gradcache_reduce_vec4",
    "tile_t": 2,
    "tile_capacity": 128,
    "alpha_threshold": 0.00392156862745098,
    "max_alpha": 0.99
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": false,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0
  },
  "output": {
    "out_json": "outputs/benchmarks/2026-05-19_star_uvt_feature_rgbpyramid_target_8f_64px_512t_f32_gradcache_reduce_vec4_10step.json",
    "contact_sheet": null,
    "contact_sheet_frames": 0,
    "contact_sheet_mode": "first",
    "side_by_side_video": null,
    "side_by_side_fps": null
  },
  "logging": {
    "wandb_enabled": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "star-uvt-feature-rgbpyramid-target-8f-64px-512t-f32-gradcache-reduce-vec4-10step",
    "wandb_tags": [
      "star_uvt",
      "feature_tubes",
      "target_feature",
      "rgb_pyramid",
      "feature_direct_gradcache_reduce_vec4"
    ],
    "wandb_mode": "offline"
  }
}
