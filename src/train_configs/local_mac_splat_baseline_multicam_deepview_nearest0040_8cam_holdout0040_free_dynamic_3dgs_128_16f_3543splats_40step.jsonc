{
  // Same split/scale as the nearest0040 raw PowerFoam row for an honest splat comparator.
  // Caveats: train_splat_baseline.py currently materializes pinhole CameraSpec objects,
  // while the matched PowerFoam row uses OPENCV_FISHEYE; this also uses fast_mac
  // instead of the older dense PyTorch renderer so the comparison is locally runnable.
  "arch": "splat_baseline_free_dynamic_3dgs",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "frame_indices": null,
    "multicam_manifest": "data/multicam_val/clip_sets/multicam_val_v1_128_4fps_16f/manifest.jsonl",
    "multicam_split": "val",
    "multicam_sample_id": "deepview_03_Dog_camera_0001_to_camera_0040",
    "multicam_sample_index": 0,
    "multicam_train_cameras": [
      "camera_0025",
      "camera_0039",
      "camera_0041",
      "camera_0012",
      "camera_0026",
      "camera_0023",
      "camera_0042",
      "camera_0038"
    ],
    "multicam_heldout_camera": "camera_0040",
    "multicam_anchor_camera": "camera_0025"
  },
  "model": {
    "support_mode": "free_dynamic_3dgs",
    "splat_mode": "per_frame",
    "num_splats": 3543,
    "init_depth": 0.5,
    "init_scale": 0.035,
    "scale_init_log_jitter": 0.0,
    "init_alpha_logit": 0.0,
    "init_xyz_noise": 0.001,
    "init_quat_noise": 0.0,
    "log_scale_min": -12.0,
    "log_scale_max": 4.0
  },
  "camera": {
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "multicam_pose_source": "auto"
  },
  "render": {
    "render_size": 128,
    "background": [1.0, 1.0, 1.0],
    "near_plane": 0.001,
    "renderer": "fast_mac",
    "tile_size": 16,
    "bound_scale": 3.0,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole"
  },
  "train": {
    "steps": 40,
    "lr": 0.002,
    "device": "auto",
    "seed": 23,
    "frames_per_step": 4,
    "train_frame_count": 16
  },
  "losses": {
    "rgb_weight": 1.0,
    "scale_weight": 0.0001,
    "temporal_smooth_weight": 0.001
  },
  "logging": {
    "log_every": 10,
    "log_to_wandb": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "splat-baseline-nearest0040-8cam-holdout0040-free-dynamic-3dgs-128-16f-3543splats-40step",
    "wandb_tags": [
      "splat-baseline",
      "free-dynamic-3dgs",
      "nearest0040",
      "8cam-holdout0040",
      "multicam-val",
      "deepview",
      "heldout-camera",
      "128px",
      "16f",
      "3543splats",
      "40step"
    ],
    "wandb_mode": "offline",
    "output_dir": "outputs/gauge_fields/multicam_deepview_nearest0040_8cam_holdout0040_40step/free_dynamic_3dgs"
  }
}
