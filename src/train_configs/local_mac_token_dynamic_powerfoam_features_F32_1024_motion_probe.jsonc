{
  "arch": "dynamic_powerfoam_metal",
  "data": {
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "frame_source": "explicit_video",
    "max_frames": 16
  },
  "model": {
    "cells": 1024,
    "neighbor_count": 32,
    "adjacency_mode": "knn",
    "dynamic_mode": "token_rbf_features",
    "time_basis_count": 8,
    "time_basis_sigma_scale": 0.75,
    "temporal_init_mode": "fit",
    "dynamic_centers": true,
    "dynamic_radii": true,
    "dynamic_densities": false,
    "dynamic_features": false,
    "dynamic_normals": true,
    "dynamic_texel_sites": true,
    "feature_dim": 32,
    "feature_init_noise": 0.01,
    "feature_rgb_init": "logit",
    "token_dim": 128,
    "token_hidden_dim": 128,
    "token_hidden_layers": 1,
    "token_init_std": 0.02,
    "token_output_init_std": 0.0001,
    "token_point_residual_scale": 0.35,
    "token_z_residual_scale": 0.04,
    "token_radius_residual_scale": 0.04,
    "token_density_residual_scale": 0.02,
    "token_feature_residual_scale": 0.05,
    "token_normal_residual_scale": 0.08,
    "token_texel_site_residual_scale": 0.12,
    "token_temporal_residual_scale": 0.8,
    "init_from_video": true,
    "image_init_depth": 2.0,
    "image_init_jitter": 0.35,
    "xy_extent": 1.25,
    "z_min": 1.0,
    "z_max": 3.25,
    "radius_init": 0.18,
    "radius_min": 0.03,
    "radius_scale": 0.72,
    "density_init": 64.0,
    "normal_init_jitter": 0.05,
    "num_texel_sites": 4,
    "texel_site_scale": 0.5
  },
  "render": {
    "render_size": 64,
    "fov_degrees": 55.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.0,
    "transmittance_threshold": 0.0001,
    "max_alpha": 0.99,
    "eps": 0.000001,
    "texel_temperature": 10.0,
    "normalize_features_by_alpha": true,
    "train_background_mode": "random_rgb",
    "eval_background_mode": "fixed_rgb",
    "background": [0.0, 0.0, 0.0],
    "random_background_min": 0.0,
    "random_background_max": 1.0
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": false,
    "weight_init": "kaiming",
    "weight_init_gain": 1.0,
    "view_condition": "none",
    "detach_view_condition": true,
    "init_rgb_identity": true
  },
  "train": {
    "steps": 120,
    "frames_per_step": 1,
    "lr": 0.015,
    "token_lr_multiplier": 1.0,
    "decoder_lr_multiplier": 1.0,
    "colorize_lr_multiplier": 0.5,
    "point_lr_multiplier": 0.1,
    "radius_lr_multiplier": 0.05,
    "density_lr_multiplier": 0.05,
    "feature_lr_multiplier": 1.0,
    "normal_lr_multiplier": 0.5,
    "texel_site_lr_multiplier": 0.25,
    "temporal_lr_multiplier": 0.35,
    "seed": 23,
    "device": "mps"
  },
  "losses": {
    "l1_weight": 1.0,
    "mse_weight": 0.1,
    "radius_l2_weight": 0.0001,
    "density_l2_weight": 0.0,
    "temporal_center_accel_weight": 0.00002,
    "temporal_radius_accel_weight": 0.00002,
    "temporal_density_accel_weight": 0.0,
    "temporal_feature_accel_weight": 0.0,
    "temporal_coeff_l2_weight": 0.0000005
  },
  "logging": {
    "log_every": 30,
    "image_log_every": 60,
    "video_log_every": 120,
    "always_log_last_step": true,
    "output_dir": "outputs/dynamic_powerfoam_metal/local_mac_token_dynamic_powerfoam_features_F32_1024_motion_probe",
    "wandb_enabled": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "local-mac-token-dynamic-powerfoam-features-F32-1024-motion-probe",
    "wandb_tags": [
      "dynamic-powerfoam",
      "metal",
      "token-rbf",
      "feature-splatting",
      "F32",
      "motion-probe",
      "random-background",
      "64px",
      "1024cells"
    ]
  }
}
