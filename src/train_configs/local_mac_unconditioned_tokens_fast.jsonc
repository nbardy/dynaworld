{
  // Fast dev-iteration baseline for adding feature splatting on top of the
  // unconditioned static/dynamic token-GS recipe.
  //
  // Mirrors local_mac_ablate_time_static_dynamic_96_32_unconditioned_strong_video_implicit_128_fast_mac_8192splats_1000step.jsonc
  // (that run was qstqjup2: 912 s / PSNR 23.03 / SSIM 0.7706 at 1000 steps),
  // shrunk so a single iteration round trip is short enough to actually iterate:
  //
  //   render 128 px -> 64 px            : 4x fewer pixels (raster + loss)
  //   frames 16    -> 8                : 2x less raster + 2x fewer decode-loop iterations
  //   tokens 96/32 -> 48/16 (=64)      : 2x fewer query tokens, smaller token-bank decode
  //   gaussians/token 64 -> 32         : 2048 splats total (vs 8192)
  //   steps 1000 -> 200                : 5x linear cut
  //   temporal_microbatch_size 4 -> 8  : one raster call per step instead of 2
  //   image_log_every 50 -> 200        : skip mid-training preview render + W&B upload
  //
  // Same arch + variant as the parent so feature-splatting changes layer cleanly
  // on top: keep the static/dynamic split, the strong RGB-uniform init, the
  // implicit camera path, and the fast-mac renderer. No video conditioning.
  "arch": "tokengs_video_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    // 64 px / 4 fps source so resize at the data boundary is a no-op.
    "video_path": "test_data/test_video_small_64_4fps.mp4",
    "frame_source": "explicit_video",
    "max_frames": 0
  },
  "model": {
    "variant": "unconditioned_tokens",
    "video_encoder_backend": "none",
    "size": 64,
    "train_frame_count": 8,
    "tokens": 64,
    "static_tokens": 48,
    "dynamic_tokens": 16,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 32,
    "model_dim": 128,
    // bottleneck_dim / num_heads / mlp_ratio / tubelet_size_t / patch_compression
    // / encoder_self_attn_layers / bottleneck_self_attn_layers / cross_attn_layers
    // are required by the trainer's build_model_from_config (direct dict lookup,
    // not in MODEL_OPTION_DEFAULTS), but UnconditionedTokenGSImplicitCamera swallows
    // them via **_unused — so they're inert at the model layer.
    "bottleneck_dim": 192,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    // F=3 = legacy RGB path. Sigmoid in head, no colorize MLP, bit-identical
    // to s6xnvoch. F!=3 swaps to feature splatting (requires v5_features
    // rasterizer fork + a colorize section at top level).
    "feature_dim": 3,
    // No encoder / no attention. The variant `unconditioned_tokens` selects
    // UnconditionedTokenGSImplicitCamera (gs_models/dynamic_video_token_gs_implicit_camera.py:1416),
    // which is just LearnedQueryTokenBank (nn.Parameter) -> MLP heads -> splats.
    // The keys below are inert (swallowed by **_unused at :1463) but the trainer
    // requires them to be present.
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 0,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 64,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 200,
    "lr": 0.001,
    "amp": false,
    "recon_backward_strategy": "batched",
    // 8 frames / temporal_microbatch_size 8 = 1 microbatch (single raster + loss call per step).
    "temporal_microbatch_size": 8
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0
  },
  "logging": {
    "log_every": 10,
    // image_log_every and video_log_every both >= steps so they only fire at
    // the final step (via always_log_last_step). Skips mid-training preview
    // renders and W&B image uploads, which dominate small-step wall clock.
    "image_log_every": 200,
    "video_log_every": 200,
    "always_log_last_step": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "unconditioned-tokens-fast",
    "wandb_tags": [
      "fast-iter",
      "unconditioned",
      "static-dynamic-split",
      "static-48",
      "dynamic-16",
      "no-video-conditioning",
      "rgb-uniform",
      "strong-token-head",
      "camera-implicit",
      "8f",
      "64px",
      "fast-mac",
      "2048splats",
      "200step",
      "feature-splatting-prep"
    ]
  }
}
