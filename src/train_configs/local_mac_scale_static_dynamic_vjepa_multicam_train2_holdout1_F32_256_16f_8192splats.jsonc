{
  // Scale-training template for the existing V-JEPA static/dynamic multicam
  // trainer. The paired launcher reads train_cameras / heldout_cameras /
  // anchor_camera / condition_camera from each manifest record and patches this
  // template into a per-record temp config before launching.
  //
  // Latest matching trainer path:
  //   src/train/train_multicam_precomputed_feature_implicit_dynamic.py
  //
  // Default manifest is the checked-in 5-sample train2/holdout1 smoke manifest
  // so config parsing and sample launches are possible before Worker B's 1k
  // manifest exists. For scale runs, pass Worker B's manifest to:
  //   src/train_scripts/train_scale_static_dynamic_vjepa_multicam.sh
  "arch": "multicam_precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": "test_data",
    "frames_dir": null,
    "video_path": null,
    "frame_source": "multicam_val",
    "max_frames": 16,
    "frame_indices": null,
    "multicam_manifest": "src/dataset_configs/multicam_train2_holdout1_5sample_128_4fps_16f_manifest.jsonl",
    "multicam_split": "train2_holdout1",
    "multicam_sample_id": "aist_gBR_sBM_d04_mBR0_ch01_train_c01_c03_holdout_c02",
    "multicam_sample_index": 0,
    "multicam_train_cameras": ["c01", "c03"],
    "multicam_heldout_cameras": ["c02"],
    "multicam_heldout_camera": null,
    "multicam_anchor_camera": "c01",
    "multicam_condition_camera": "c01"
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "data/feature_cache/scale_static_dynamic_vjepa2_1_vitb_384_F32_256px",
    "sample_cache_key": "scale-static-dynamic-vjepa2-1-vitb-384-F32-256-16f-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": true,
    "release_extractor_after_prebake": true,
    "save_dtype": "float16",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 384,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "size": 256,
    "train_frame_count": 16,
    "tokens": 128,
    "static_tokens": 96,
    "dynamic_tokens": 32,
    "dynamic_time_basis_count": 8,
    "dynamic_time_max_frequency": 8.0,
    "dynamic_motion_extent": 0.375,
    "dynamic_rotation_degrees": 10.0,
    "dynamic_alpha_logit_extent": 2.0,
    "dynamic_coeff_output_init_std": 0.0001,
    "gaussians_per_token": 64,
    "model_dim": 128,
    "bottleneck_dim": 256,
    "num_heads": 8,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.8,
    "head_hidden_dim": 64,
    "head_hidden_layers": 1,
    "head_output_init_std": 0.12,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "rgb_init": "uniform",
    "rgb_init_min": 0.0,
    "rgb_init_max": 1.0,
    "feature_dim": 32,
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 2,
    "cross_attn_layers": 4,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 3.0,
    "max_radius_scale": 1.1,
    "max_rotation_degrees": 1.0,
    "max_translation_ratio": 0.03,
    "rig_init": "aist",
    "rig_radius": 3.0,
    "rig_learn_global_se3": true,
    "rig_learn_per_camera_se3": true,
    "rig_anchor_policy": "soft",
    "rig_rotation_degrees": 15.0,
    "rig_translation_ratio": 0.2,
    "rig_regularization_weight": 0.0001
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 256,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "camera_projection": "legacy_pinhole",
    "fast_mac": {
      "tile_size": 16,
      "feature_variant": "v5_features",
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "feature_background": 0.0,
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 1000,
    "lr": 0.0003,
    "camera_rig_lr": 0.0003,
    "train_views_per_step": 0,
    "camera_swap_mode": "external_rig",
    "camera_swap_pairs_per_step": 0,
    "camera_swap_include_self": true,
    "camera_swap_include_cross": true,
    "camera_swap_self_pair_probability": null,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "colorize": {
    "hidden_dim": null,
    "activation": "sigmoid",
    "pre_norm": true,
    "weight_init": "kaiming",
    "weight_init_gain": 4.0,
    "view_condition": "none",
    "detach_view_condition": true
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.0,
    "camera_temporal_weight": 0.0,
    "camera_global_weight": 0.0,
    "static_alpha_rate_weight": 0.0,
    "dynamic_alpha_rate_weight": 0.0,
    "dynamic_motion_rate_weight": 0.0,
    "dynamic_rotation_rate_weight": 0.0,
    "dynamic_alpha_time_rate_weight": 0.0,
    "background": {
      "train_mode": "random_rgb",
      "eval_mode": "white",
      "fixed_rgb": [1.0, 1.0, 1.0],
      "sample_scope": "step"
    }
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 250,
    "video_log_every": 500,
    "always_log_last_step": true,
    "feature_pca_log": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "scale-static-dynamic-vjepa-multicam-train2-holdout1-F32-256px-8192splats",
    "wandb_tags": [
      "scale-manifest",
      "multicam",
      "train2-holdout1",
      "heldout-camera",
      "feature-splatting",
      "feature-dim-32",
      "alpha-aware-composition",
      "random-background",
      "colorize-1x1-sigmoid",
      "colorize-LN-kaiming-g4",
      "pca-viz",
      "vjepa2-1-vitb-384",
      "precomputed-features",
      "static-dynamic-split",
      "static-96",
      "dynamic-32",
      "cross-attn-4",
      "16f",
      "256px",
      "fast-mac",
      "8192splats",
      "1000step",
      "lr3e-4",
      "camera-clamped"
    ]
  }
}
