{
  // Small WorldTubes / STAR UVT visual-smoke lane for the three-representation
  // comparison harness. Matched to the tiny local test video used by the
  // dynamic PowerFoam and fast-mac dynamic-gsplat smokes.
  "arch": "star_uvt_video_overfit",
  "data": {
    "video_path": "test_data/test_video_small_128_4fps.mp4",
    "start_seconds": null,
    "fps": null,
    "duration_seconds": null,
    "image_crop_mode": "center_square",
    "target_size": 64,
    "max_frames": 16
  },
  "train": {
    "steps": 20,
    "lr": 0.12,
    "device": "mps",
    "seed": 43,
    "render_benchmark_repeats": 2,
    "require_loss_decrease": false
  },
  "uvt": {
    "tube_count": 1024,
    "init_mode": "video_samples",
    "spatial_precision": 0.125,
    "temporal_precision": 2.0,
    "opacity": 0.7,
    "sample_mode": "stratified",
    "velocity_init": "zero",
    "velocity_search_radius": 4,
    "velocity_patch_radius": 1,
    "velocity_min_improvement_ratio": 0.9,
    "final_lr": null,
    "final_lr_start_step": null,
    "coarse_target_size": null,
    "coarse_steps": 0,
    "coarse_lr": null,
    "appearance_refine_steps": 0,
    "appearance_lr": 0.04,
    "temporal_split_step": null,
    "temporal_split_offset": 0.5,
    "temporal_split_precision_scale": 2.0,
    "temporal_split_opacity_scale": 1.0,
    "temporal_split_depth_offset": 0.0001,
    "temporal_split_lr": null,
    "render_backend": "metal_tile",
    "reduction_mode": "index_add",
    "sample_emission_mode": "direct_atomic",
    "tile_t": 1,
    "tile_capacity": 128,
    "tile_load_reg_weight": 0.0,
    "tile_load_target": 0.0,
    "skip_uvt": false
  },
  "per_frame": {
    "splats": 8,
    "lr": 0.12,
    "init_mode": "random",
    "render_backend": "dense",
    "fast_max_pairs": 2048,
    "spatial_precision": 0.25,
    "opacity": 0.35,
    "sample_mode": "random",
    "skip_per_frame": true
  },
  "output": {
    "out_json": "outputs/visual_comparisons/star_uvt_worldtubes_metal_64_16f_20step.json",
    "contact_sheet": "outputs/visual_comparisons/star_uvt_worldtubes_metal_64_16f_20step_contact.jpg",
    "contact_sheet_frames": 8,
    "contact_sheet_mode": "linspace",
    "side_by_side_video": "outputs/visual_comparisons/star_uvt_worldtubes_metal_64_16f_20step_sbs.mp4",
    "side_by_side_fps": 4.0
  },
  "logging": {
    "wandb_enabled": true,
    "wandb_project": "dynaworld",
    "wandb_run_name": "visual-compare-star-uvt-worldtubes-metal-64-16f-20step",
    "wandb_tags": [
      "visual-compare",
      "worldtubes",
      "star_uvt",
      "rgb_tubes",
      "metal_tile",
      "direct_atomic",
      "64px",
      "16f"
    ],
    "wandb_mode": "offline"
  }
}
