{
  // Fast proof gate for the 100-item natural-FPS 64-frame V-JEPA lane.
  // Uses the same cached V-JEPA features as the heavier 8192-splat config but
  // cuts the renderer/model load so the full 100-row cycle can finish locally.
  "arch": "precomputed_feature_implicit_camera",
  "data": {
    "sequence_dir": null,
    "frames_dir": null,
    "video_path": null,
    "manifest_path": "data/single_video_pretrain/dynaworld_single_video_pretrain_100_64f_v0/train_manifest.jsonl",
    "split": "train",
    "eval_manifest_path": null,
    "eval_split": "eval",
    "eval_max_sequences": 0,
    "train_manifest_load_mode": "eager",
    "train_manifest_sample_mode": "cycle",
    "frame_source": "explicit_video_window",
    "max_frames": 0
  },
  "features": {
    "extractor": "vjepa_torchhub",
    "model_id": "vjepa2_1_vit_base_384",
    "cache_dir": "data/feature_cache/single_video_pretrain_100_vjepa2_1_vitb_256crop_64f_nativefps",
    "sample_cache_key": "single-video-pretrain-100-vjepa2-1-vitb-256crop-64f-nativefps-v1",
    "cache_version": 1,
    "force_rebake": false,
    "keep_in_memory": false,
    "release_extractor_after_prebake": true,
    "save_dtype": "float16",
    "torch_dtype": "float32",
    "layers": ["vjepa_tokens"],
    "vjepa_feature_dim": 768,
    "vjepa_pretrained": true,
    "vjepa_crop_size": 256,
    "vjepa_checkpoint_url": "https://dl.fbaipublicfiles.com/vjepa2/vjepa2_1_vitb_dist_vitG_384.pt"
  },
  "model": {
    "variant": "learned_time_orbit_path",
    "video_encoder_backend": "precomputed",
    "video_feature_layers": null,
    "video_feature_channels": null,
    "video_feature_token_stride": 9,
    "video_feature_output_dtype": null,
    "size": 128,
    "train_frame_count": 64,
    "tokens": 32,
    "gaussians_per_token": 16,
    "model_dim": 64,
    "bottleneck_dim": 128,
    "num_heads": 4,
    "mlp_ratio": 4.0,
    "scene_extent": 1.5,
    "xy_extent": 1.5,
    "z_min": 0.5,
    "z_max": 5.0,
    "scale_init": 0.02,
    "scale_init_log_jitter": 0.7,
    "opacity_init": 0.1,
    "query_token_init_std": 0.3,
    "head_output_init_std": 0.06,
    "position_init_extent_coverage": 0.9,
    "rotation_init": "random",
    "tubelet_size_t": 4,
    "patch_compression": 16,
    "encoder_self_attn_layers": 1,
    "bottleneck_self_attn_layers": 1,
    "cross_attn_layers": 1,
    "time_fourier_bands": 8,
    "time_max_frequency": 128.0
  },
  "camera": {
    "global_head": "legacy_orbit",
    "lens_model": "pinhole",
    "base_fov_degrees": 60.0,
    "base_radius": 3.0,
    "max_fov_delta_degrees": 15.0,
    "max_radius_scale": 1.5,
    "max_rotation_degrees": 5.0,
    "max_translation_ratio": 0.2
  },
  "render": {
    "renderer": "fast_mac",
    "render_size": 64,
    "auto_dense_limit": 400000,
    "tile_size": 16,
    "bound_scale": 3.0,
    "near_plane": 0.05,
    "alpha_threshold": 0.00392156862745098,
    "fast_mac": {
      "tile_size": 16,
      "max_fast_pairs": 2048,
      "alpha_threshold": 0.00392156862745098,
      "transmittance_threshold": 0.0001,
      "background": [1.0, 1.0, 1.0],
      "enable_overflow_fallback": true,
      "batch_strategy": "flatten",
      "batch_launch_limit_tiles": 262144,
      "batch_launch_limit_gaussians": 262144
    }
  },
  "train": {
    "steps": 100,
    "lr": 0.001,
    "amp": false,
    "recon_backward_strategy": "batched",
    "temporal_microbatch_size": 4
  },
  "losses": {
    "type": "standard_gs",
    "l1_weight": 0.8,
    "dssim_weight": 0.2,
    "mse_weight": 0.2,
    "ssim_window_size": 11,
    "camera_motion_weight": 0.01,
    "camera_temporal_weight": 0.02,
    "camera_global_weight": 0.005
  },
  "logging": {
    "log_every": 10,
    "image_log_every": 100,
    "video_log_every": 100,
    "always_log_last_step": true,
    "log_initial_media": false,
    "wandb_project": "dynaworld",
    "wandb_run_name": "single-video-pretrain-100-precomputed-vjepa2-1-vitb-256crop-64f-fast-proof-64render-512splats",
    "wandb_tags": [
      "single-video-pretrain",
      "100items",
      "cycle-sampler",
      "64f",
      "natural-fps",
      "precomputed-features",
      "feature-token-stride-9",
      "fast-proof",
      "512splats",
      "64render",
      "vjepa2-1",
      "torchhub",
      "vitb-384-checkpoint",
      "256crop",
      "fp32-encoder",
      "frozen-encoder",
      "implicit-camera",
      "fast-mac"
    ]
  }
}
